PORT=8000
NODE_ENV=development

# MongoDB Atlas connection string. Get this from Atlas → Database → Connect → Drivers.
# Never commit a real value here — use backend/.env (gitignored) for actual credentials.
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/scaner?retryWrites=true&w=majority"

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=qrfs_token

# Allowed frontend origin(s) — used for CORS and to build QR/share
# links (https://frontend/share/:shareId). Never the backend's own URL.
# Comma-separated list to allow multiple origins (e.g. local + production).
# The FIRST entry is used as the canonical origin for redirects/QR links,
# so put the production URL first when listing more than one.
# Local dev only:        http://localhost:5173
# Production (Render):   https://frontend-qr-zvh1.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must point at THIS backend's own /api/auth/google/callback route.
# Local dev:  http://localhost:8000/api/auth/google/callback
# Production: https://qr-9i95.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Storage driver: "local" (filesystem, default for dev) or "r2" (Cloudflare R2 / any S3-compatible service)
STORAGE_DRIVER=local

# Used when STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=../storage/uploads

# Used when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

MAX_FILE_SIZE_MB=25
